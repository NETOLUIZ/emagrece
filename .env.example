# Configuração do Firebase (veja README.md > "Configurar o Firebase")
# Copie este arquivo para ".env" e preencha com os valores do seu projeto Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# E-mail usado internamente para o login da tela /admin.
# Crie um usuário com este e-mail em Authentication > Users no Firebase.
VITE_ADMIN_EMAIL=dona@emagrecenapraia.app
